{
  "name": "scrapemaster",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db": "mkdir -p .data/db && mongod --dbpath .data/db --port 27017 --bind_ip 127.0.0.1",
    "test:coverage": "vitest run --coverage",
    "feeds:refresh": "tsx --conditions=react-server scripts/refresh-feeds.mts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@vercel/functions": "^3.9.11",
    "axios": "^1.7.9",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "mongoose": "^8.8.3",
    "next": "^15.5.27",
    "nodemailer": "^10.0.13",
    "puppeteer-core": "^25.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
