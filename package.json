{
  "name": "scrapemaster",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db": "mkdir -p .data/db && mongod --dbpath .data/db --port 27017 --bind_ip 127.0.0.1",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "mongoose": "^8.8.3",
    "next": "^15.5.26",
    "nodemailer": "^6.9.16",
    "puppeteer-core": "^23.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.16",
    "typescript": "^5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": "22.x"
  }
}
