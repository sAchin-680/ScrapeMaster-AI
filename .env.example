# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/scrapemaster

# Public base URL of the deployment (used for metadata, sitemap and email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Bright Data residential proxy credentials for scraping
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=

# SMTP credentials for price alert emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="ScrapeMaster <alerts@example.com>"

# Shared secret required to trigger the price refresh cron endpoint
CRON_SECRET=change-me

# Browser rendering for stores that block plain HTTP clients (Flipkart).
# Local/Docker: path to Chrome or Chromium. Serverless: a remote browser
# WebSocket endpoint (e.g. Browserless or Bright Data Scraping Browser).
CHROME_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
BROWSER_WS_ENDPOINT=
