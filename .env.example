# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/scrapemaster

# Public base URL of the deployment (used for metadata, sitemap and email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Bright Data residential proxy credentials for scraping
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=

# SMTP credentials for price alert emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="ScrapeMaster <alerts@example.com>"

# Shared secret required to trigger the price refresh cron endpoint
CRON_SECRET=change-me
